{
  "name": "prompt2change",
  "version": "1.0.0",
  "description": "Firefox BYOK extension to restyle and remix websites with AI prompts, inspired by ClickRemix.",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "build": "wxt build -b firefox",
    "build:all": "wxt build",
    "zip": "wxt zip -b firefox",
    "compile": "tsc --noEmit"
  },
  "keywords": [
    "firefox-extension",
    "webextension",
    "ai",
    "clickremix",
    "byok",
    "openrouter",
    "svelte5",
    "unocss"
  ],
